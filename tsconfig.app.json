{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.vue",
    "app/i18n/*.json",
    "test/app/**/*.ts",
    "src/cards/types.ts",
    "src/cards/grade.ts"
  ]
}
